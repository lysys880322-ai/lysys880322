# Streamlit Cloud에 배포할 때, 앱 설정 화면의 "Secrets"에 아래 내용을 붙여넣고
# 실제 값으로 채우세요. 이 파일 자체(.streamlit/secrets.toml)는 절대 Git에 올리지 않습니다.

GEMINI_API_KEY = "여기에_발급받은_키_붙여넣기"
GEMINI_MODEL = "gemini-flash-latest"

# 배포용 로그인 설정 — AUTH_MODE를 "web"으로 하면 웹 배포용 로그인 방식을 쓴다.
AUTH_MODE = "web"
GOOGLE_WEB_CLIENT_ID = "Google Cloud에서 만든 '웹 애플리케이션' OAuth 클라이언트 ID"
GOOGLE_WEB_CLIENT_SECRET = "그 클라이언트의 보안 비밀번호(secret)"
# 실제 배포된 주소 그대로 (예: https://ys-youtube-translator.streamlit.app)
APP_BASE_URL = "https://여기에-배포된-주소.streamlit.app"

# 이 화면에 아무나 못 들어오게 막는 비밀번호 — 원하는 값으로 바꾸세요.
ACCESS_PASSWORD = "원하는_비밀번호"
