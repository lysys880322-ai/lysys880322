# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤 값을 채워넣으세요.
# .env 파일은 절대 Git에 올리지 마세요(.gitignore에 이미 등록되어 있습니다).

# Google Cloud에서 만든 OAuth 클라이언트(데스크톱 앱) json 파일 경로
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json

# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=여기에_발급받은_키_붙여넣기

# 번역에 사용할 Gemini 모델 (특별한 이유 없으면 기본값 사용 권장)
GEMINI_MODEL=gemini-flash-latest
